NODE_ENV=development
PORT=3000
APP_NAME=Sugar & Snouts
APP_ENV=development

# Generate with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_48_HEX_CHARS

# Password pepper — HMAC-SHA256 applied to passwords before bcrypt.
# A stolen database is useless without this secret. Generate with: openssl rand -hex 32
# To rotate: set PASSWORD_PEPPER_OLD=<old value>, PASSWORD_PEPPER=<new value>
# Users will be transparently re-hashed on next login.
PASSWORD_PEPPER=CHANGE_ME_32_HEX_CHARS
PASSWORD_PEPPER_OLD=

# Admin email (used to seed the first admin account on first run)
ADMIN_EMAIL=admin@sugarandsnouts.co.uk
ADMIN_PASSWORD=ChangeMe123!

# Database path
DATABASE_PATH=/opt/sugarandsnouts/data/sugarandsnouts.db

# Upload path for product images
UPLOAD_PATH=/opt/sugarandsnouts/uploads

# Cookie settings
COOKIE_SECURE=false
TRUST_PROXY=false
COOKIE_MAX_AGE_HOURS=72

# Contact form email (optional - contact form stores to DB if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sugarandsnouts.co.uk
CONTACT_EMAIL=SugarandSnouts02@gmail.com
